<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Loupedeck.HerdrPlugin</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The package root: the manifest and icons from package/, the assemblies in bin/. -->
    <PackageDir>$(MSBuildThisFileDirectory)../../build/$(Configuration)/</PackageDir>
    <OutputPath>$(PackageDir)bin/</OutputPath>
    <PluginDir>$(HOME)/Library/Application Support/Logi/LogiPluginService/Plugins/</PluginDir>
    <PluginName>Herdr</PluginName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the Plugin Service supplies PluginApi and its dependencies. -->
    <PackageReference Include="LogiPluginApi" Version="6.4.2.3567" ExcludeAssets="runtime;native" />
    <!-- Compiled in rather than referenced, so the plugin ships as one assembly. -->
    <Compile Include="../Herdr.Core/*.cs" LinkBase="Core" />
  </ItemGroup>

  <!-- LogiPluginApi brings StyleCop and a pinned NetAnalyzers along, which
       enforce Logitech's own code style; the SDK's built-in analyzers stay. -->
  <Target Name="DropPluginApiAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('/.nuget/packages/'))" />
    </ItemGroup>
  </Target>

  <Target Name="CopyPackage" AfterTargets="Build">
    <ItemGroup>
      <PackageFiles Include="$(MSBuildThisFileDirectory)../../package/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PackageDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- A Debug build on a Mac links the build into the Plugin Service and reloads it. -->
  <Target Name="LinkPlugin" AfterTargets="CopyPackage"
          Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::IsOSPlatform('OSX')) and '$(CI)' != 'true'">
    <WriteLinesToFile File="$(PluginDir)$(MSBuildProjectName).link" Lines="$([System.IO.Path]::GetFullPath('$(PackageDir)'))" Overwrite="true" />
    <Exec Command="open loupedeck:plugin/$(PluginName)/reload" ContinueOnError="true" />
    <Message Text="Linked $(PluginDir)$(MSBuildProjectName).link and asked the Plugin Service to reload $(PluginName)" Importance="High" />
  </Target>

  <Target Name="UnlinkPlugin" AfterTargets="Clean" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Delete Files="$(PluginDir)$(MSBuildProjectName).link" />
  </Target>

</Project>
