<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManifestPath>$(MSBuildThisFileDirectory)package/metadata/LoupedeckPackage.yaml</ManifestPath>
    <!-- The plugin manifest is the one place the version is written down. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ManifestPath)')), '(?m)^version:\s*(\S+)').Groups[1].Value)</Version>
  </PropertyGroup>
</Project>
